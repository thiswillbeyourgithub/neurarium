#!/bin/sh
# pre-push hook: refuse to push anything other than the `main` branch.
#
# This guards against accidentally pushing a stray local branch (or tag) to a
# remote. Deploy here is by rsync, not git, so `main` is the only ref that ever
# legitimately leaves this machine.
#
# Tracked in the repo as the single source of truth and activated *locally*
# with:
#     git config core.hooksPath tools/git-hooks
# (a fresh clone must run that once; the setting lives in .git/config and is not
# itself committed). See CLAUDE.md "Git hooks".
#
# Git feeds this hook one line per ref being pushed on stdin:
#     <local ref> SP <local sha> SP <remote ref> SP <remote sha>
# We crash the push (non-zero exit) as soon as any local ref is not
# refs/heads/main. That also blocks tags (refs/tags/...) and branch deletes
# (local ref "(delete)"), which are likewise not "pushing main".

remote_name="$1"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  if [ "$local_ref" != "refs/heads/main" ]; then
    echo "pre-push: refusing to push '$local_ref' to '${remote_name:-remote}';" \
         "only the 'main' branch may be pushed from here." >&2
    status=1
  fi
done

# The branch is fine. Before anything optional, run the JS free-variable check
# (tools/check_js.py): it takes under a second, reads only the files in public/ that
# the browser loads, and needs no author-side data, so unlike the dataset check below
# it neither prompts nor can be skipped. It catches the one bug class that ships
# happily past `node --check`: a name referenced in a scope where nothing binds it,
# which the browser raises only when that exact line finally runs.
if [ "$status" -eq 0 ]; then
  py=$(command -v python || command -v python3)
  if [ -z "$py" ]; then
    echo "pre-push: no python interpreter found; skipping the JS check." >&2
  elif ! "$py" tools/check_js.py >&2; then
    echo "pre-push: unbound JS reference(s); aborting push." >&2
    status=1
  fi
fi

# Same footing for the JS unit tests (tools/tests/*.test.mjs, node's built-in runner,
# about two seconds, no author-side data): they pin the viewer's pure modules and the
# tour's selector anchors, which nothing else exercises before a visitor does.
if [ "$status" -eq 0 ]; then
  if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: no node found; skipping the JS tests." >&2
  elif ! node --test tools/tests/*.test.mjs >&2; then
    echo "pre-push: JS tests failed; aborting push." >&2
    status=1
  fi
fi

# Same footing for the freshness family of the dataset check (check_data.py
# --only freshness): an editable online corpus (Wikipedia, PDSP, GtoPdb, ...) cited
# from a download over 12 months old must be refetched, and that must not hinge on
# answering "y" below. It reads only committed files, so it runs on any clone.
if [ "$status" -eq 0 ] && [ -n "$py" ]; then
  if ! "$py" tools/check_data.py --only freshness >&2; then
    echo "pre-push: an editable corpus is stale or undated; refetch it (tools/README.md). Aborting push." >&2
    status=1
  fi
fi

# offer to run the dataset integrity check
# (tools/check_data.py) before letting the push through. Prompt + answer go
# to the controlling terminal, because stdin here is git's ref list (consumed
# by the loop above), not the keyboard. A non-interactive push (no controlling
# terminal, e.g. a script) silently skips the prompt so it never hangs.
# Answering "y" runs the check and a *failed* check (data errors) aborts the
# push; warnings (e.g. the known TODO source urls) pass.
#
# The guard actually *opens* /dev/tty for writing rather than testing `-r`: the
# device node is readable-bit-set even with no controlling terminal, but opening
# it then fails with ENXIO. The probe runs in a *subshell* `( : >/dev/tty )`
# because `:` is a POSIX special built-in, so in dash a failed redirection on it
# would exit the whole shell (killing the hook); the subshell contains that, and
# its exit status is non-zero exactly when /dev/tty can't be opened, which is the
# real "are we interactive?" question.
if [ "$status" -eq 0 ] && [ -n "$py" ]; then
  # Every committed generated artifact (public/data, llms.txt, the README blocks, the
  # baked-mesh hashes) must match its generator: offline, about two seconds.
  if ! "$py" -m unittest tools.tests.test_generated_artifacts_fresh >&2; then
    echo "pre-push: a generated artifact is stale; regenerate it (see the test output). Aborting push." >&2
    status=1
  fi
fi
# NEURARIUM_DATA_CHECK=y|n answers the prompt below in advance (no tty needed): the
# local deploy script sets it from its own -y / prompt when it pushes (`deploy.sh
# --push`), so one answer covers the push and the deploy and the check runs once.
# Any other value, or unset, falls back to asking on the terminal.
answer="${NEURARIUM_DATA_CHECK:-}"
case "$answer" in
  [YyNn]*) tty_out=/dev/stderr ;;
  *) answer="" ; tty_out=/dev/tty ;;
esac
if [ "$status" -eq 0 ] && { [ -n "$answer" ] || ( : >/dev/tty ) 2>/dev/null; }; then
  if [ -z "$answer" ]; then
    printf 'pre-push: run the data integrity check (tools/check_data.py) first? [y/N] ' >/dev/tty
    read -r answer </dev/tty
  else
    echo "pre-push: data check answer '$answer' from NEURARIUM_DATA_CHECK." >"$tty_out"
  fi
  case "$answer" in
    [Yy]*)
      py=$(command -v python || command -v python3)
      if [ -z "$py" ]; then
        echo "pre-push: no python interpreter found; skipping the data check." >"$tty_out"
      elif "$py" tools/check_data.py >"$tty_out" 2>&1; then
        echo "pre-push: data check passed." >"$tty_out"
      else
        echo "pre-push: data check reported errors; aborting push." >"$tty_out"
        status=1
      fi
      ;;
    *)
      echo "pre-push: skipping the data check." >"$tty_out"
      ;;
  esac
fi

exit "$status"
