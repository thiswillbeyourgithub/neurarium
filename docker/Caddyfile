# Caddy config for the static neurarium brain visualizer.
#
# Listens on :8359 (the compose file maps it to 127.0.0.1:8359 on the host, so a
# reverse proxy is expected in front). Serves the project root, which is
# bind-mounted read-only at /srv by docker-compose.yml.

{
	# No ACME/TLS in here: TLS is terminated by the host reverse proxy. Turning
	# auto_https off keeps Caddy from trying to manage certs (it would fail on
	# the read-only rootfs anyway). admin off drops the local admin API surface.
	admin off
	auto_https off

	# rate_limit comes from the caddy-ratelimit module (built into the binary by
	# docker/Dockerfile), so it is not in Caddy's default directive order and must
	# be placed explicitly. Run it first, before headers/file_server, so a flood is
	# rejected cheaply.
	order rate_limit before header

	# TLS + the public connection terminate at the host reverse proxy, so the peer
	# Caddy sees is that proxy (a loopback / private address), not the visitor.
	# Trust private-range peers so {client_ip} resolves to the real client from the
	# proxy's X-Forwarded-For header (used as the rate-limit key below). Harmless if
	# the proxy is on a private/loopback address (it is); see the rate_limit note.
	servers {
		trusted_proxies static private_ranges
	}
}

:8359 {
	root * /srv

	encode gzip zstd

	# Generous per-client flood guard (caddy-ratelimit module), purely to blunt a
	# single-source DoS, NOT to ration normal use. A cold page load is ~100 requests
	# (index + JS modules + meta.json + the ~40 shape files), so 600 events / 10s per
	# client leaves room for several full loads back-to-back and forgives quickly; a
	# client past it gets 429 until its window drains.
	#
	# Keyed on {client_ip} = the real visitor IP, which requires the host reverse
	# proxy to send X-Forwarded-For (it is trusted via `trusted_proxies` above). If
	# that proxy does NOT forward XFF, {client_ip} falls back to the proxy's own IP,
	# so every visitor would share one bucket: in that setup, do rate limiting at the
	# front proxy instead and drop this block.
	rate_limit {
		zone flood {
			key {client_ip}
			events 600
			window 10s
		}
	}

	# The runtime app config (window.__APP_CONFIG__) is rendered from the
	# container environment (ANALYTICS_* + DEV from docker/.env, STARTED_AT
	# stamped at start) by docker/entrypoint.sh into /gen, a writable tmpfs, at
	# container start; serve THAT for /app-config.js instead of the repo's static
	# local-dev fallback under /srv. Rendering once at startup, rather than
	# templating the file on every request, means Caddy never parses the JS as a
	# Go template, so a stray brace marker in the file can't 500 it (which used to
	# take analytics AND the DEV banner down together). The file is named
	# generically, not "analytics-*", so content filters / proxies that block
	# "analytics" paths don't 404 it.
	handle /app-config.js {
		root * /gen
		file_server
	}
	handle {
		file_server
	}

	# Hardening headers for a static, same-origin app.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server

		# Content-Security-Policy. three.js and the gated eruda debug console
		# (loaded only on ?debug=1) are both vendored same-origin now, so the
		# only remaining optional third-party origin is the umami tracker, whose
		# origin entrypoint.sh derives from ANALYTICS_URL into ANALYTICS_ORIGIN
		# (empty when analytics is off, leaving no extra origin).
		# 'unsafe-inline' is required for script/style because this is a no-build
		# site with an inline <script type="importmap">, the inline eruda gate, and
		# an inline <style> block (no bundler to hash/nonce them); it could be
		# tightened to hashes later. font-src allows data: because eruda embeds its
		# icon font as a data: URI (without it the debug console's icons render as
		# tofu/X). default-src 'self' + the locked-down
		# base-uri/object-src/frame-ancestors/form-action are the main wins.
		# connect-src also allows https://*.wikipedia.org: the drug panel fetches the
		# current Wikipedia lead at runtime to refresh a drug's description (js/wiki.js,
		# anonymous CORS GETs to the Wikimedia REST + action APIs); a baked copy is the
		# offline fallback, so a blocked/failed fetch degrades silently.
		# img-src also allows https://upload.wikimedia.org: the structure panel
		# embeds each region's Wikipedia illustration GIF by hot-linking it from
		# Wikimedia Commons at runtime (only the URL is stored, not the multi-MB
		# binary), with a spinner while it loads and a silent hide on failure. Unlike
		# the small drug molecule SVGs (vendored same-origin), these animations are
		# too large to commit, so they are loaded live like the descriptions above.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://upload.wikimedia.org; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' {$ANALYTICS_ORIGIN:}; connect-src 'self' https://*.wikipedia.org {$ANALYTICS_ORIGIN:}"

		# Cache-Control is set just below, not here, so these hardening headers
		# still apply to every response.
	}

	# Cache policy: `no-cache` on EVERYTHING (data, code and shell alike).
	#
	# `no-cache` is not "don't cache": it is "you may store this, but you MUST
	# revalidate with the server before every use". Since file_server sends an
	# ETag, an unchanged file revalidates to a bodyless `304 Not Modified`, so a
	# repeat visit is both guaranteed-fresh AND nearly free. Nothing is ever
	# served without the server confirming it, which is the whole requirement.
	#
	# Code used to be `no-store` to protect this no-build site (ES modules
	# deployed by rsync, no content-hashed filenames) from *heuristic* caching
	# serving a stale js/*.js next to a fresh one. `no-cache` rules heuristics out
	# just as absolutely (every use is revalidated) while saving the ~1 MB of
	# code + shell that `no-store` forced every single load to re-download: on a
	# phone that re-download, not the data, was what made a reload crawl.
	header Cache-Control "no-cache"

	# Go's mime table (what file_server uses) has no `.webmanifest` entry, so the
	# PWA manifest would ship as octet-stream and some browsers reject it. Pin the
	# correct type. (Python's dev server, tools/serve.py, already knows it.)
	@webmanifest path *.webmanifest
	header @webmanifest Content-Type "application/manifest+json"

	log {
		output stdout
		format console
	}
}
